# clang-format configuration for Standard Clojure Style in C
#
# We start from the LLVM style and change as little as possible.
# Run `make format` to format the code and `make format-check` to verify it.
BasedOnStyle: LLVM
IndentWidth: 2
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
PointerAlignment: Right
# the test suite #includes standard-clojure-style.c on purpose; never reorder includes
SortIncludes: Never
